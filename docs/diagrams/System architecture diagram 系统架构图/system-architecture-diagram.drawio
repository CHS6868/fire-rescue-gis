<mxfile host="app.diagrams.net" modified="2026-11-10T00:00:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="diagram1" name="Page-1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="FireRescue GIS – System Architecture Diagram" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="3" value="Users&#xa;Admin&#xa;Operator&#xa;Viewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="150" as="geometry"/></mxCell><mxCell id="4" value="Frontend Web Application&#xa;&#xa;React + TypeScript + Vite&#xa;Tailwind CSS&#xa;React Leaflet / OpenStreetMap&#xa;Pages: Login, Dashboard, Incidents, Resources, Scenarios, Reports&#xa;Socket.IO Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="380" height="280" as="geometry"/></mxCell><mxCell id="5" value="Backend Application Server&#xa;&#xa;Node.js + Express&#xa;REST API Layer&#xa;Authentication &amp; Authorization&#xa;Incident Management&#xa;Resource Management&#xa;Scenario Management&#xa;Routing Service Wrapper&#xa;Socket.IO Server&#xa;Validation / Error Handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf0;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="410" height="390" as="geometry"/></mxCell><mxCell id="6" value="Database&#xa;&#xa;Supabase / PostgreSQL&#xa;PostGIS (optional)&#xa;Users&#xa;Scenarios&#xa;Fire Incidents&#xa;Fire Stations&#xa;Fire Trucks&#xa;Fire Hydrants&#xa;Incident History&#xa;Route Results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="240" height="180" as="geometry"/></mxCell><mxCell id="7" value="External Routing API&#xa;&#xa;openrouteservice&#xa;Directions API&#xa;Distance / Duration&#xa;Route Geometry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f0ff;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="410" width="240" height="150" as="geometry"/></mxCell><mxCell id="8" value="Real-Time Event Flow&#xa;&#xa;Socket.IO delivers real-time updates:&#xa;• incident created&#xa;• incident status updated&#xa;• resource updated&#xa;• scenario reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="500" width="380" height="180" as="geometry"/></mxCell><mxCell id="9" value="Development &amp; Deployment&#xa;&#xa;GitHub&#xa;Version Control&#xa;Pull Requests&#xa;GitHub Actions&#xa;Deployment to Web Hosting (future)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="600" width="410" height="160" as="geometry"/></mxCell><mxCell id="10" value="Notes&#xa;&#xa;Simulation-only system: real map background + simulated incidents and emergency resources.&#xa;Route results are for educational planning only and must not be used for actual emergency dispatch decisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f0;strokeColor=black;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1500" height="150" as="geometry"/></mxCell><mxCell id="11" value="Browser access" style="endArrow=block